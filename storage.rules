rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Videos de partidos: subida pública (solo video, hasta 10 GB), sin lectura desde la web.
    match /uploads/{signupId}/{file} {
      allow read: if false;
      allow write: if request.resource.size < 10 * 1024 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
