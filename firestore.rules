rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lista de espera: cualquiera puede apuntarse (create) con campos validados.
    // Nadie lee desde la web; se lee desde la consola de Firebase.
    // Contadores diarios anónimos: solo se puede sumar de a uno.
    match /stats/{dia} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['vistas','clicsCTA','altas','videos'])
        && request.resource.data.get('vistas',0) <= 1 && request.resource.data.get('clicsCTA',0) <= 1
        && request.resource.data.get('altas',0) <= 1 && request.resource.data.get('videos',0) <= 1;
      allow update: if request.resource.data.keys().hasOnly(['vistas','clicsCTA','altas','videos'])
        && request.resource.data.get('vistas',0) <= resource.data.get('vistas',0) + 1
        && request.resource.data.get('clicsCTA',0) <= resource.data.get('clicsCTA',0) + 1
        && request.resource.data.get('altas',0) <= resource.data.get('altas',0) + 1
        && request.resource.data.get('videos',0) <= resource.data.get('videos',0) + 1;
      allow delete: if false;
    }
    match /signups/{id} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasAll(['nombre','apellido','email','estado','creado'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() < 80
        && request.resource.data.apellido is string && request.resource.data.apellido.size() > 0 && request.resource.data.apellido.size() < 80
        && request.resource.data.email is string && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.estado == 'apuntado';
      // Solo se pueden tocar los campos del video, nunca nombre/email.
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['tieneVideo','videoPath','estado','lado','inicio','nombreArchivo','bytes','subido']);
      allow delete: if false;
    }
  }
}
